# Copy to .env and fill in. Do not commit .env.
# Only cluster login / namespace are required for a fresh deploy.

OCP_API=https://api.example.openshift.com:6443
OCP_TOKEN=sha256~...
NAMESPACE=casino-sentinel
INSECURE=true

# --- Optional (defaults elsewhere; do not set unless you need to override) ---
#
# App images (default: quay.io/shailendra14k/sentinel-{python,ui}:<short-git-sha>):
#   ./scripts/build-push-images.sh
#   SENTINEL_PYTHON_IMAGE=quay.io/shailendra14k/sentinel-python:<sha>
#   SENTINEL_UI_IMAGE=quay.io/shailendra14k/sentinel-ui:<sha>
#   # REGISTRY=quay.io/shailendra14k
#
# TFM / OpenShift AI (--rhoai):
#   Default: SENTINEL_TFM_IMAGE=quay.io/shailendra14k/casino-tfm-embed:latest
#   Rebuild (opt-in; sources in model/decoder-foundation-model/, gitignored):
#     TAG=latest ./scripts/build-push-images.sh --tfm
#   HARDWARE_PROFILE_NAME=gpu-profile
#   HARDWARE_PROFILE_NAMESPACE=redhat-ods-applications
#   # SKIP_FREE_GPU=false
#   # RHOAI_WAIT_TIMEOUT=600
#   # RHOAI_ENABLE_KSERVE=true
#   # NGC_API_KEY not required
