# Copy to .env and fill in. Do not commit .env.
OCP_API=https://api.example.openshift.com:6443
OCP_TOKEN=sha256~...
NAMESPACE=casino-sentinel
INSECURE=true

# NGC_API_KEY is NOT required for the demo.
# NeMo ServingRuntime pulls from the public Quay mirror:
#   quay.io/shailendra14k/nemo:25.09.01
# (mirror of nvcr.io/nvidia/nemo:25.09.01 — see manifests/08-openshift-ai/).
# Optional only if you still pull other images from nvcr.io:
# NGC_API_KEY=nvapi-YOUR_KEY_HERE

# Optional --rhoai: must match an enabled Hardware profile in OpenShift AI
# (Settings → Hardware profiles). Llama demo often uses gpu-profile.
HARDWARE_PROFILE_NAME=gpu-profile
HARDWARE_PROFILE_NAMESPACE=redhat-ods-applications

# Optional --rhoai: set true to keep llama / other GPU models running (not recommended on 1-GPU labs)
# SKIP_FREE_GPU=false

# Optional --rhoai: wait for OpenShift AI KServe CRDs / auto-enable on DataScienceCluster
# RHOAI_WAIT_TIMEOUT=600
# RHOAI_ENABLE_KSERVE=true
