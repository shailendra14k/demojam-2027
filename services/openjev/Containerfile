# OpenJev decision server — Verdict backend (CPU-friendly, Apache-2.0 weights).
# Compatible with TypeSafe System One: POST /v1/systemone
# Full DiffusionGemma GPU image is razorback16/openjev (optional; needs ≥24GB GPU).
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OPENJEV_BACKEND=verdict \
    OPENJEV_HOST=0.0.0.0 \
    OPENJEV_PORT=8080 \
    HF_HOME=/models/hf

RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Install OpenJev with Verdict extras (typed System One API).
RUN pip install --upgrade pip \
    && git clone --depth 1 https://github.com/razorback16/openjev.git /tmp/openjev \
    && pip install -e "/tmp/openjev[verdict]"

RUN mkdir -p /models/hf && useradd -r -u 1001 -g root openjev \
    && chown -R 1001:0 /app /models && chmod -R g=u /app /models

USER 1001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/v1/models || exit 1

CMD ["python", "-m", "openjev"]
